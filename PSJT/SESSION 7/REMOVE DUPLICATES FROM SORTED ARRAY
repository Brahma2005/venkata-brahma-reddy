class Solution {
    public int removeDuplicates(int[] nums) {
        int k = 1; // Points to the position for the next unique element

        for (int i = 1; i < nums.length; i++) {
            if (nums[i] != nums[i - 1]) {
                nums[k] = nums[i];
                k++;
            }
        }

        return k;
    }
}



